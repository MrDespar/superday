#compdef superday sd ./superday
#
# Generated by `superday completions --write` from ib/cli.py's parser.
# Do not hand-edit: `superday selftest` fails when this file and the parser
# disagree, and a hand-edit is exactly how they come to disagree.

_superday() {
  local -a subcmds
  subcmds=(
    'ingest:parse corpus docx into the bank'
    'ingest-pdf:extract questions from the PDF guides'
    'ingest-epub:extract questions from EPUB guides'
    'ingest-web:extract questions from a forum thread, article or saved page'
    'ingest-filing:build questions from a company'"'"'s filed XBRL figures'
    'ingest-pack:land an authored question pack (JSON, no API key)'
    'reground:re-read ingested PDFs to repair provenance and phrasings'
    'enrich:real rubrics, topics and difficulty via LLM'
    'audit:second-opinion QA over extracted questions'
    'review:work the review queue'
    'accept-all:accept everything pending review'
    'drill:get asked questions'
    'browse:walk the bank by topic and tag, stacking filters'
    'recap:the questions you have already answered, and how they went'
    'chains:question lines: follow-ups that need the question before them'
    'sessions:drill and mock sittings, and what can be resumed'
    'dashboard:single-screen executive readiness dashboard'
    'tag:add tags to a question'
    'untag:remove tags from a question'
    'plan:daily pace needed to be ready by an interview date'
    'dupes:find and merge near-duplicate questions in the bank'
    'mock:timed mock interview with a scorecard'
    'autotag:apply the concept taxonomy across the bank, no API key needed'
    'tags:every concept tag, with size and how it has gone'
    'market:seed and refresh market awareness questions'
    'add:add a single question you ran into'
    'list:list topics, or drill one: list <topic>'
    'gate:what the admission gate admitted, merged and dropped'
    'cross-audit:an independent second opinion, next to the first'
    'disagreements:where the two audit passes do not agree'
    'check:find answers that are provably wrong, no API key needed'
    'show:everything known about one question'
    'edit:edit a question'"'"'s text, answer, topic or rubric'
    'undo:take back the last status change'
    'find:full text search across the bank'
    'export:back the bank up: JSON, Markdown, .sqlite or Anki'
    'consult:batch questions out to any model as Markdown, file the reply back'
    'completions:regenerate the zsh completion file from this parser'
    'selftest:run the regression tests'
    'stats:what is in the bank'
    'usage:how many provider calls you have made, and what got refused'
    'llm:which provider answers, and whether its key works'
    'settings:view or change configuration'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' subcmds
    return
  fi

  case ${words[2]} in
    ingest)
      _arguments \
        '1:path:_files' \
        '--force[re-ingest an already seen file]'
      ;;
    ingest-pdf)
      _arguments \
        '1:path:_files' \
        '--force[re-ingest an already seen file]' \
        '--window[pages per chunk (default: 6)]:window:' \
        '--max-chunks[stop early, for a trial run against a new book]:max_chunks:'
      ;;
    ingest-epub)
      _arguments \
        '1:path:_files' \
        '--force[re-ingest an already seen file]' \
        '--window[characters per extraction chunk]:CHARS:' \
        '--max-chunks[stop early, for a trial run against a new book]:max_chunks:'
      ;;
    ingest-web)
      _arguments \
        '*:url:' \
        '--asked[mark these as asked in a real interview (outranks textbook Qs)]' \
        '--force[re-ingest even if unchanged]'
      ;;
    ingest-filing)
      _arguments \
        '1:ticker:' \
        '--year[fiscal year (default: most recent filed)]:FY:' \
        '--dry-run[print the questions without saving them]'
      ;;
    ingest-pack)
      _arguments \
        '*:path:_files' \
        '--status[override the status the pack asks for]:status:(needs_review active)' \
        '--dry-run[validate and show the spread without saving]'
      ;;
    reground)
      _arguments \
        '1:path:_files' \
        '--window[pages per chunk, must match the ingest run]:window:' \
        '--show[how many unmatched candidate phrases to list at the end]:show:'
      ;;
    enrich)
      _arguments \
        '--batch[batch size (default: 6)]:batch:' \
        '--limit[max to process]:limit:' \
        '--missing-answers[auto-draft model answers and rubrics for questions without one]'
      ;;
    audit)
      _arguments \
        '--batch[batch size (default: 8)]:batch:' \
        '--limit[max to process]:limit:' \
        '--status[status to audit (default: needs_review)]:status:(needs_review active)'
      ;;
    review)
      _arguments \
        '--limit[limit]:limit:'
      ;;
    accept-all)
      _arguments \
        '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]'
      ;;
    drill)
      _arguments \
        '(-n --count)'{-n,--count}'[how many questions]:count:' \
        '(-t --topic)'{-t,--topic}'[topic filter]:topic:' \
        '--tag[tag filter (e.g. ev-bridge, irr)]:tag:' \
        '(-k --kind)'{-k,--kind}'[kind]:kind:(technical market_awareness behavioural)' \
        '--no-grade[reveal rubric immediately rather than grading your spoken answer]' \
        '--local[guarantee zero API calls: self-rate against the stored rubric]' \
        '(-w --weak)'{-w,--weak}'[worst-rated questions first instead of a fresh spread]' \
        '(-r --resume)'{-r,--resume}'[pick up the sitting you walked away from]' \
        '--ids[drill exactly these question ids (what `browse` hands over)]:1,2,3:' \
        '(-a --again)'{-a,--again}'[ignore the due window and ask anyway (the quarantine still applies)]'
      ;;
    browse)
      _arguments \
        '(-t --topic)'{-t,--topic}'[start filtered to this topic (repeatable)]:topic:' \
        '--tag[start filtered to this tag or tag family (repeatable)]:tag:' \
        '(-k --kind)'{-k,--kind}'[start filtered to this question kind (repeatable)]:kind:(technical market_awareness behavioural)' \
        '--flag[start filtered to due / unseen / weak / disputed / untagged]:flag:(disputed due unseen untagged weak)' \
        '--all[include needs_review and rejected, not just active]' \
        '--tags-all[require every tag rather than any of them]' \
        '--any[OR the filters together instead of AND-ing them]' \
        '--json[machine-readable selection]'
      ;;
    recap)
      _arguments \
        '1:window:' \
        '--limit[limit]:limit:' \
        '--json[machine-readable]'
      ;;
    chains)
      _arguments \
        '--scan[find questions that read like a reply to the one before]' \
        '--tier[certain names a previous turn; likely opens like a reply]:tier:(all certain likely)' \
        '--apply[with --scan: link every candidate that has a lead-in]' \
        '--link[record that CHILD follows PARENT]:CHILD PARENT:' \
        '--unlink[drop a question'"'"'s lead-in]:CHILD:' \
        '--standalone[it reads like a follow-up but is fine alone - stop asking]:ID:' \
        '--graph[the whole line this question sits in, as a tree]:ID:' \
        '--json[machine-readable]'
      ;;
    sessions)
      _arguments \
        '--limit[limit]:limit:'
      ;;
    dashboard)
      _arguments \
        '--json[machine-readable readiness snapshot]'
      ;;
    tag)
      _arguments \
        '1:id:' \
        '*:tags:' \
        '--kind[tag classification (default: concept)]:kind:(concept topic company difficulty)'
      ;;
    untag)
      _arguments \
        '1:id:' \
        '*:tags:'
      ;;
    plan)
      _arguments \
        '1:date:' \
        '--minutes[minutes a day you can actually give it]:N:' \
        '--json[machine-readable plan]'
      ;;
    dupes)
      _arguments \
        '--threshold[similarity threshold (default: 0.70)]:threshold:' \
        '(-t --topic)'{-t,--topic}'[filter to specific topic]:topic:' \
        '--pair[put two questions side by side, facet by facet]:A,B:' \
        '--merge[fold DUPE into KEEPER, keeping reviews, notes and tags]:KEEPER,DUPE:' \
        '--distinct[they are different questions - stop proposing the pair]:A,B:' \
        '--undistinct[undo a --distinct verdict - the scan will propose the pair again]:A,B:' \
        '--all[include pairs already settled as different]' \
        '--phrasings[wordings that no longer ask the question they hang off]' \
        '--detach[take one phrasing off its question]:ID:' \
        '--keep-phrasing[that wording belongs where it is - stop proposing it]:ID:' \
        '--json[machine-readable]'
      ;;
    mock)
      _arguments \
        '1:round:(screen technical superday fit dcm ecm midmarket)' \
        '--persona[interviewer persona (standard, skeptical_md, exacting_vp)]:persona:(standard skeptical_md exacting_vp)' \
        '--local[guarantee zero API calls: self-rate at the end]' \
        '--ids[draw only from these question ids (what `browse` hands over)]:1,2,3:'
      ;;
    autotag)
      _arguments \
        '--limit[stop after N questions]:limit:' \
        '--all[re-scan questions that already carry tags]'
      ;;
    tags)
      _arguments \
        '--prune[remove tags no question carries]' \
        '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]' \
        '--min[hide tags carried by fewer than N questions]:N:' \
        '--json[machine-readable tag map]'
      ;;
    market)
      _arguments \
        '--refresh[pull every provider into the cache so drills work offline]'
      ;;
    add)
      _arguments \
        '*:text:' \
        '(-a --answer)'{-a,--answer}'[model answer, if you have one]:answer:' \
        '(-l --llm)'{-l,--llm}'[one LLM call: topic, rubric and a full answer (polishing --answer if y]' \
        '(-o --origin)'{-o,--origin}'[origin]:origin:(self_authored interviewer_asked published)'
      ;;
    list)
      _arguments \
        '1:topic:(accounting ev_eqv valuation dcf ma lbo dcm ecm deal_process markets behavioural general)'
      ;;
    gate)
      _arguments \
        '--source[filter to one source, by title substring]:source:' \
        '--limit[limit]:limit:'
      ;;
    cross-audit)
      _arguments \
        '--export[write a batch to JSON for Claude Code to review]:PATH:' \
        '--import[file verdicts from a reviewed batch]:import_path:' \
        '--apply[write filed corrections into the bank (all, or these ids)]:1,2,3:' \
        '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]' \
        '--api[run it unattended on a provider you hold a key for]' \
        '--using[pin the second opinion to this provider instead of letting it pick one]:PROVIDER:(gemini claude openai)' \
        '--target[which questions to check (default: ones the first audit kept)]:target:(kept needs_review active all)' \
        '--limit[how many, per run]:limit:' \
        '--batch[questions per API call]:batch:'
      ;;
    disagreements)
      _arguments \
        '(-r --review)'{-r,--review}'[work through them one at a time]' \
        '--limit[limit]:limit:'
      ;;
    check)
      _arguments \
        '--all[include rejected and unreviewed questions]' \
        '--limit[stop after N questions]:limit:' \
        '--json[machine-readable findings]'
      ;;
    show)
      _arguments \
        '--json[the whole record as JSON]' \
        '1:id:'
      ;;
    edit)
      _arguments \
        '1:id:'
      ;;
    undo)
      _arguments \
        '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]'
      ;;
    find)
      _arguments \
        '--tag[restrict to a concept tag]:tag:' \
        '--exact[FTS only: do not fall back to closest-match]' \
        '--json[machine-readable results]' \
        '*:query:' \
        '--limit[limit]:limit:' \
        '--all[include rejected and unreviewed]' \
        '--semantic[semantic vector similarity search via embeddings]' \
        '--index-embeddings[backfill vector embeddings for questions]'
      ;;
    export)
      _arguments \
        '1:out:_files' \
        '--sqlite[byte-exact db copy instead of JSON]' \
        '--anki[export active questions to Anki-compatible TSV]' \
        '--md[readable Markdown, one file per topic plus an index]' \
        '--with-progress[include your ratings, notes and schedule (off by default)]'
      ;;
    consult)
      _arguments \
        '--export[write a review batch (default: consult-batch.md)]:PATH:' \
        '--import[file the verdicts from a reply]:PATH:' \
        '--provider[who answered, e.g. gpt-5 (recorded with the verdict)]:provider:' \
        '--limit[questions per batch]:limit:' \
        '--include-seen[include questions an outside model has already judged]'
      ;;
    completions)
      _arguments \
        '--write[write it, do not just print it]'
      ;;
    selftest)
      # no arguments
      ;;
    stats)
      # no arguments
      ;;
    usage)
      _arguments \
        '--provider[only one provider'"'"'s calls]:provider:(gemini claude openai)' \
        '--clear[empty the log]' \
        '--json[machine-readable]'
      ;;
    llm)
      _arguments \
        '--test[spend one small call proving a key works; omit the name to test every ]:PROVIDER:' \
        '--use[switch every job to this provider]:PROVIDER:(gemini claude openai)' \
        '--json[machine-readable]'
      ;;
    settings)
      _arguments \
        '1:key:(corpus_dir inbox_dir ingest_globs exclude_globs desired_retention grade_mode theme drill_scrollback interview_date sec_contact export_md_dir llm_provider gemini_api_key anthropic_api_key openai_api_key model_enrich model_grade model_audit model_embed thinking_level min_call_interval rate_limit_rpm rate_limit_rpd)' \
        '*:value:' \
        '--reset[revert this key to its default]'
      ;;
  esac
}

_superday "$@"
