# Copy to .env.local and fill in what you need. .env.local is gitignored and
# is the only file in this repo that holds a secret.
#
# Prefer setting these through the tool rather than by hand -- it validates the
# value, writes the file 0600 and shows you where each setting came from:
#
#   superday settings openai_api_key sk-...
#   superday llm --use openai
#   superday llm --test                     # does the key actually work?
#   superday settings                       # the whole list, with sources
#
# ---------------------------------------------------------------- provider

# Who answers: gemini | claude | openai. One setting moves the whole tool --
# extraction, enrich, audit, grading and embeddings all follow it, and the
# model defaults below change with it.
IB_PROVIDER=gemini

# ---------------------------------------------------------------- keys
# You only need the key for the provider you actually use. The others being
# unset is not a problem and the tool will not ask for them.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.anthropic.com/settings/keys
# A second key is what lets `cross-audit --api` run: that pass needs a provider
# other than the one that gave the first opinion, and Claude is its preference.
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------- what needs a key
#
# A key buys exactly four things: extraction from PDF/EPUB/web, `enrich`,
# `audit`, and grading a *typed* answer.
#
# Everything else works with no key at all -- ingest (docx), ingest-pack,
# ingest-filing, the admission gate, drill, mock, find, browse, list, stats,
# show, edit, check, chains, dupes, cross-audit (export/import), consult.
# Self-rating never calls out, so the whole bank is drillable offline.

# ---------------------------------------------------------------- models
# All optional. Left unset, each falls back to the sensible default for
# whichever provider is selected, so you do not have to set these when you
# switch.
#
# Stored per provider, because a model name only means something next to the
# vendor that sells it: `settings model_enrich <name>` writes the variable for
# whoever is answering, and the other two keep their own.
#
# IB_MODEL_ENRICH_GEMINI=   # enrich, and extraction
# IB_MODEL_GRADE_CLAUDE=    # drill / mock grading
# IB_MODEL_AUDIT_OPENAI=    # the audit pass; not the extraction model
# IB_MODEL_EMBED_GEMINI=    # find --semantic. Anthropic sells no embeddings
#                           # endpoint, so on Claude that search falls back to
#                           # keywords and says so.
#
# The older un-suffixed spellings (IB_MODEL_ENRICH=...) still work, but only
# for the vendor whose model they name -- a Gemini model left behind after a
# switch to Claude is a setting that stopped applying, not an instruction to
# ask Anthropic for it. `llm` shows any that are being ignored.

# Reasoning budget, and the main cost lever: minimal | low | medium | high.
# Extraction, enrich and audit already ask for less of it; this overrides
# every caller. Sent as thinkingLevel to Gemini, effort to Claude and
# reasoning_effort to OpenAI.
# IB_THINKING_LEVEL=

# Floor between LLM calls, in seconds. Raise it if you are hitting rate limits.
# IB_MIN_CALL_INTERVAL=
